{
	"name": "qe",
	"version": "1.0.0",
	"description": "Portfolio site",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
		"postbuild": "next-sitemap --config next-sitemap.config.cjs",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"dev:prod": "cross-env NODE_OPTIONS=--no-deprecation sh -c \"rm -rf .next && pnpm run build && pnpm start\"",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"ii": "pnpm install",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
		"lint:biome": "biome lint ./src",
		"lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"reinstall": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
		"seed:apply": "cross-env NODE_OPTIONS=--no-deprecation tsx -r tsconfig-paths/register src/scripts/run-seed.ts --disable-transpile",
		"seed:generate": "cross-env NODE_OPTIONS=--no-deprecation tsx -r tsconfig-paths/register src/scripts/generate-seed.ts",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"test": "pnpm run test:int && pnpm run test:e2e",
		"test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
		"test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
	},
	"dependencies": {
		"@gsap/react": "^2.1.2",
		"@payloadcms/admin-bar": "3.86.0",
		"@payloadcms/db-postgres": "3.86.0",
		"@payloadcms/live-preview-react": "3.86.0",
		"@payloadcms/next": "3.86.0",
		"@payloadcms/payload-cloud": "3.86.0",
		"@payloadcms/plugin-form-builder": "3.86.0",
		"@payloadcms/plugin-nested-docs": "3.86.0",
		"@payloadcms/plugin-redirects": "3.86.0",
		"@payloadcms/plugin-search": "3.86.0",
		"@payloadcms/plugin-seo": "3.86.0",
		"@payloadcms/richtext-lexical": "3.86.0",
		"@payloadcms/storage-vercel-blob": "3.86.0",
		"@payloadcms/ui": "3.86.0",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-checkbox": "^1.0.4",
		"@radix-ui/react-label": "^2.0.2",
		"@radix-ui/react-select": "^2.0.0",
		"@radix-ui/react-slot": "^1.2.3",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.6.1",
		"@types/three": "^0.185.1",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"cross-env": "^7.0.3",
		"dotenv": "16.4.7",
		"geist": "^1.3.0",
		"graphql": "^16.8.2",
		"gsap": "^3.13.0",
		"lenis": "^1.3.14",
		"leva": "^0.10.1",
		"lucide-react": "^0.378.0",
		"next": "^16.2.12",
		"next-intl": "^4.13.4",
		"next-sitemap": "^4.2.3",
		"payload": "3.86.0",
		"prism-react-renderer": "^2.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "7.45.4",
		"sharp": "0.34.2",
		"tailwind-merge": "^2.3.0",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.185.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@eslint/eslintrc": "^3.2.0",
		"@playwright/test": "1.54.1",
		"@tailwindcss/postcss": "^4.1.17",
		"@tailwindcss/typography": "^0.5.13",
		"@testing-library/react": "16.3.0",
		"@types/escape-html": "^1.0.2",
		"@types/node": "22.5.4",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@vitejs/plugin-react": "4.5.2",
		"copyfiles": "^2.4.1",
		"eslint": "^9.16.0",
		"eslint-config-next": "16.2.12",
		"jsdom": "26.1.0",
		"playwright": "1.54.1",
		"playwright-core": "1.54.1",
		"postcss": "^8.4.38",
		"prettier": "^3.6.2",
		"tailwindcss": "^4.1.17",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.7.3",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.3"
	}
}
